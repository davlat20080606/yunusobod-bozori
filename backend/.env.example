# Copy this file to backend/.env and fill in the values. backend/.env is in .gitignore: Git never sees it.
# On Render the same names go to Environment. Never put real values in this file or anywhere in the code.

# From @BotFather. If it ever leaks: /revoke in @BotFather, then put the new one here and in Render
TELEGRAM_BOT_TOKEN=
# Public https address of the site, e.g. https://bozorbot.uz
WEBAPP_URL=http://localhost:3000
# Neon Postgres connection string; empty = local SQLite file
DATABASE_URL=sqlite+aiosqlite:///./bozor.db
# Bozorkom PIN (6 digits)
ADMIN_PIN=
# Signs sign-ins of sellers, workers and the Bozorkom: long random text, e.g. from
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# Changing it signs everyone out (they sign in again with their PIN)
AUTH_SECRET=
# polling (local) | webhook (cloud) | auto
BOT_MODE=auto

# Cloudflare R2 for photos and videos; empty = kept in the database
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
